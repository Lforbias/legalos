model TaskDependency {
 id String @id @default(uuid()) @db.Uuid
 organizationId String @map("organization_id") @db.Uuid
 taskId String @unique @map("task_id") @db.Uuid
 predecessorId String @map("predecessor_id") @db.Uuid
