  organizationId String    @map("organization_id") @db.Uuid
  name           String
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("cost_centers")
}

model FinanceEntry {
  id               String             @id @default(uuid()) @db.Uuid
  organizationId   String             @map("organization_id") @db.Uuid
  kind             FinanceEntryKind
  type             FinanceEntryType   @default(OTHER)
  status           FinanceEntryStatus @default(OPEN)
  description      String
  amount           Decimal            @db.Decimal(14, 2)
  paidAmount       Decimal            @default(0) @map("paid_amount") @db.Decimal(14, 2)
  issueDate        DateTime           @map("issue_date") @db.Date
  dueDate          DateTime           @map("due_date") @db.Date
  accountId        String?            @map("account_id") @db.Uuid
  categoryId       String?            @map("category_id") @db.Uuid
  costCenterId     String?            @map("cost_center_id") @db.Uuid
  clientId         String?            @map("client_id") @db.Uuid
  caseId           String?            @map("case_id") @db.Uuid
  counterparty     String?
  notes            String?
  groupId          String?            @map("group_id") @db.Uuid
  installmentNo    Int?               @map("installment_no")
  installmentTotal Int?               @map("installment_total")
  boletoCode       String?            @map("boleto_code")
  boletoUrl        String?            @map("boleto_url")
  invoiceId        String?            @map("invoice_id") @db.Uuid
  canceledAt       DateTime?          @map("canceled_at") @db.Timestamptz(3)
  canceledReason   String?            @map("canceled_reason")
  canceledById     String?            @map("canceled_by_id") @db.Uuid
  createdById      String?            @map("created_by_id") @db.Uuid
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  payments     FinancePayment[]
  invoice      FeeInvoice?      @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([organizationId, dueDate])
  @@map("finance_entries")
}

model FeeInvoice {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  number         Int
  clientId       String    @map("client_id") @db.Uuid
  issuedOn       DateTime  @map("issued_on") @db.Date
  total          Decimal   @db.Decimal(14, 2)
  notes          String?
  canceledAt     DateTime? @map("canceled_at") @db.Timestamptz(3)
  canceledReason String?   @map("canceled_reason")
  createdById    String?   @map("created_by_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entries      FinanceEntry[]

  @@unique([organizationId, number])
  @@index([organizationId, clientId])
  @@map("fee_invoices")
}

model FinancePayment {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  entryId        String    @map("entry_id") @db.Uuid
  accountId      String    @map("account_id") @db.Uuid
  amount         Decimal   @db.Decimal(14, 2)
  paidOn         DateTime  @map("paid_on") @db.Date
  method         String?
  note           String?
  createdById    String?   @map("created_by_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  reversedAt     DateTime? @map("reversed_at") @db.Timestamptz(3)
  reversedById   String?   @map("reversed_by_id") @db.Uuid
  reversalReason String?   @map("reversal_reason")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entry        FinanceEntry @relation(fields: [entryId], references: [id], onDelete: Restrict)

  @@index([entryId])
  @@map("finance_payments")
}

model AiUsage {
