/// 2.0-F15: comunicados do developer (novidade, manutenção, alerta) por aviso no sistema e/ou no celular.
/// O texto é escrito pelo developer e NUNCA deve conter dados de clientes (passa pelo serviço de push).
model Announcement {
  id             String   @id @default(uuid()) @db.Uuid
  kind           String
  title          String
  body           String
  link           String?
  audience       String
  organizationId String?  @map("organization_id") @db.Uuid
  targetUserId   String?  @map("target_user_id") @db.Uuid
  viaInApp       Boolean  @default(true) @map("via_in_app")
  viaPush        Boolean  @default(false) @map("via_push")
  recipients     Int      @default(0)
  inAppCount     Int      @default(0) @map("in_app_count")
  pushSent       Int      @default(0) @map("push_sent")
  pushFailed     Int      @default(0) @map("push_failed")
  createdById    String?  @map("created_by_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([createdAt(sort: Desc)])
  @@map("announcements")
}

// ---------- 3.0-F1: cadastro único de partes, campos personalizados e notas do processo ----------

enum RegistryKind {
  PERSON
  COMPANY
  ORGAN
  LAWYER
}

/// Parte reaproveitável entre processos (adversários, advogados, órgãos). Clientes continuam no cadastro de clientes.
model PartyRegistry {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  kind           RegistryKind @default(PERSON)
  name           String
  document       String?
  profession     String?
  issuingOrgan   String?      @map("issuing_organ")
  email          String?
  phone          String?
  notes          String?
  createdById    String?      @map("created_by_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt      DateTime?    @map("deleted_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  caseParties  CaseParty[]

  @@index([organizationId, name])
  @@map("party_registry")
}

enum CustomFieldType {
  TEXT
  NUMBER
  DATE
  SELECT
}

model CustomFieldDef {
