model ActivityChecklistItem {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  checklistId String @map("checklist_id") @db.Uuid
  body String
  done Boolean @default(false)
  position Int @default(0)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  checklist ActivityChecklist @relation(fields:[checklistId, organizationId], references:[id, organizationId], onDelete:Cascade)
  @@index([organizationId, checklistId])
  @@map("activity_checklist_items")
}
model ActivityCollaborator {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  activityKind String @map("activity_kind")
  activityId String @map("activity_id") @db.Uuid
  userId String @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  @@unique([organizationId, activityKind, activityId, userId])
  @@map("activity_collaborators")
}
model ActivitySeries {
