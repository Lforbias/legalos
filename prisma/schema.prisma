  organizationId String   @map("organization_id") @db.Uuid
  noticeId       String   @map("notice_id") @db.Uuid
  kind           String
  actorId        String?  @map("actor_id") @db.Uuid
  runId          String?  @map("run_id") @db.Uuid
  data           Json     @default("{}")
