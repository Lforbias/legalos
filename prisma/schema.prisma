model WhatsappConversation {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  accountId      String    @map("account_id") @db.Uuid
  waId           String    @map("wa_id")
  contactName    String?   @map("contact_name")
  clientId       String?   @map("client_id") @db.Uuid
  caseId         String?   @map("case_id") @db.Uuid
  leadId         String?   @map("lead_id") @db.Uuid
  queueId        String?   @map("queue_id") @db.Uuid
  assignedAt     DateTime? @map("assigned_at") @db.Timestamptz(3)
  assignedToId   String?   @map("assigned_to_id") @db.Uuid
  status         String    @default("OPEN")
  lastMessageAt  DateTime? @map("last_message_at") @db.Timestamptz(3)
  lastInboundAt  DateTime? @map("last_inbound_at") @db.Timestamptz(3)
  lastAwayAt     DateTime? @map("last_away_at") @db.Timestamptz(3)
  lastPreview    String?   @map("last_preview")
  unreadCount    Int       @default(0) @map("unread_count")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization   Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  account        WhatsappAccount             @relation(fields: [accountId], references: [id], onDelete: Cascade)
  client         Client?                     @relation(fields: [clientId], references: [id], onDelete: SetNull)
  case           Case?                       @relation("WhatsappCase", fields: [caseId], references: [id], onDelete: SetNull)
  lead           Lead?                       @relation("WhatsappLead", fields: [leadId], references: [id], onDelete: SetNull)
  queue          WhatsappQueue?              @relation(fields: [queueId], references: [id], onDelete: SetNull)
  assignedTo     User?                       @relation("WhatsappAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  messages       WhatsappMessage[]
  labels         WhatsappConversationLabel[]
  fieldValues    WhatsappFieldValue[]
  automationRuns WhatsappAutomationRun[]
  botSession     WhatsappBotSession?
  slaAlerts      WhatsappSlaAlert[]
  followUps      WhatsappFollowUp[]
  scheduled      WhatsappScheduledMessage[]
  surveys        WhatsappSurvey[]

  @@unique([accountId, waId])
  @@index([clientId])
  @@index([caseId])
  @@index([leadId])
  @@map("whatsapp_conversations")
}

model WhatsappQueue {
  id             String   @id @default(uuid()) @db.Uuid
