  label             String
  phoneNumberId     String?   @unique @map("phone_number_id")
  wabaId            String?   @map("waba_id")
  displayPhone      String?   @map("display_phone")
  tokenEnc          String?   @map("token_enc")
  provider          String    @default("META")
  qrState           String    @default("DISCONNECTED") @map("qr_state")
  qrCode            String?   @map("qr_code")
  qrPhone           String?   @map("qr_phone")
  qrUpdatedAt       DateTime? @map("qr_updated_at") @db.Timestamptz(3)
  riskAckAt         DateTime? @map("risk_ack_at") @db.Timestamptz(3)
  riskAckById       String?   @map("risk_ack_by_id") @db.Uuid
  enabled           Boolean   @default(true)
  awayEnabled       Boolean   @default(false) @map("away_enabled")
  autoAssignEnabled Boolean   @default(true) @map("auto_assign_enabled")
  awayMessage       String?   @map("away_message")
  openFrom          String    @default("09:00") @map("open_from")
  openUntil         String    @default("18:00") @map("open_until")
  openDays          Int[]     @default([1, 2, 3, 4, 5]) @map("open_days")
  lastStatus        String?   @map("last_status")
  lastMessage       String?   @map("last_message")
  lastCheckAt       DateTime? @map("last_check_at") @db.Timestamptz(3)
  createdById       String?   @map("created_by_id") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization  Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
