// LegalOS — schema da Fase 1 (fundação multiempresa).
// Convenção: tabelas e colunas em snake_case (via @map), datas em UTC, IDs uuid.
// Toda entidade pertencente a um escritório carrega organization_id.

generator client {
  provider        = "prisma-client-js"
  engineType      = "client"
  previewFeatures = ["queryCompiler", "driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
}

enum EmailTokenType {
  VERIFY_EMAIL
  PASSWORD_RESET
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

enum AuditResult {
  SUCCESS
  FAILURE
  DENIED
}

model User {
  id                      String    @id @default(uuid()) @db.Uuid
  email                   String    @unique
  name                    String
  passwordHash            String    @map("password_hash")
  emailVerifiedAt         DateTime? @map("email_verified_at") @db.Timestamptz(3)
  locale                  String    @default("pt-BR")
  timezone                String    @default("America/Sao_Paulo")
  notificationPreferences Json      @default("{}") @map("notification_preferences")
  disabledAt              DateTime? @map("disabled_at") @db.Timestamptz(3)
  lastLoginAt             DateTime? @map("last_login_at") @db.Timestamptz(3)
  failedLoginCount        Int       @default(0) @map("failed_login_count")
  lockedUntil             DateTime? @map("locked_until") @db.Timestamptz(3)
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions          Session[]
  emailTokens       EmailToken[]
  memberships       Membership[]
  auditLogs         AuditLog[]
  caseMembers       CaseMember[]
  notifications     Notification[]
  timeEntries       TimeEntry[]
  mfa               UserMfa?
  platformAdmin     PlatformAdmin?
  ownedCertificates Certificate[]     @relation("CertificateOwner")
  mfaRecoveryCodes  MfaRecoveryCode[]
  mfaChallenges     MfaChallenge[]

  whatsappAssigned  WhatsappConversation[] @relation("WhatsappAssignee")
  whatsappAgents    WhatsappAgent[]
  whatsappAuthored  WhatsappMessage[]      @relation("WhatsappAuthor")
  pushSubscriptions PushSubscription[]
  pushPreferences   PushPreference[]
  pushDeliveries    PushDelivery[]

  @@map("users")
}

model Session {
  id                   String    @id @default(uuid()) @db.Uuid
  userId               String    @map("user_id") @db.Uuid
  tokenHash            String    @unique @map("token_hash")
  activeOrganizationId String?   @map("active_organization_id") @db.Uuid
  userAgent            String?   @map("user_agent")
  ipAddress            String?   @map("ip_address")
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt           DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  expiresAt            DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt            DateTime? @map("revoked_at") @db.Timestamptz(3)

  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganization Organization? @relation(fields: [activeOrganizationId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("sessions")
}

model EmailToken {
  id        String         @id @default(uuid()) @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  type      EmailTokenType
  tokenHash String         @unique @map("token_hash")
  expiresAt DateTime       @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime?      @map("used_at") @db.Timestamptz(3)
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("email_tokens")
}

model Organization {
  id               String             @id @default(uuid()) @db.Uuid
  name             String
  slug             String             @unique
  legalName        String?            @map("legal_name")
  document         String?
  timezone         String             @default("America/Sao_Paulo")
  /// 2.0-F6: exige verificação em duas etapas de todos os membros internos (exceto cliente do portal).
  requireMfa       Boolean            @default(false) @map("require_mfa")
  locale           String             @default("pt-BR")
  currency         String             @default("BRL")
  settings         Json               @default("{}")
  aiEnabled        Boolean            @default(false) @map("ai_enabled")
  datajudEnabled   Boolean            @default(false) @map("datajud_enabled")
  /// 3.0-F5: permite agendar o protocolo de petições aprovadas (nasce desligado).
  petitionScheduleEnabled Boolean     @default(false) @map("petition_schedule_enabled")
  /// 3.0-F10: cobra créditos por ação (nasce desligado). `creditsLowThreshold` = aviso de saldo baixo (0 = sem aviso).
  creditsEnabled          Boolean     @default(false) @map("credits_enabled")
  creditsLowThreshold     Int         @default(0) @map("credits_low_threshold")
  creditGrants            CreditGrant[]
  creditUsages            CreditUsage[]
  courtCredentials        CourtCredential[]
  clientCredentials       ClientCredential[]
  courtSystemMaps         CourtSystemMap[]
  kanbanBoards            KanbanBoard[]
  workflowPackages        WorkflowPackage[]
  googleIntegration       GoogleIntegration?
  documentClassifications DocumentClassification[]
  suspendedAt      DateTime?          @map("suspended_at") @db.Timestamptz(3)
  suspendedReason  String?            @map("suspended_reason")
  certificates     Certificate[]
  certificateUsage CertificateUsage[]
  courtConnections CourtConnection[]
  djenMonitors     DjenMonitor[]
  createdById      String?            @map("created_by_id") @db.Uuid
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt        DateTime?          @map("deleted_at") @db.Timestamptz(3)

  roles                   Role[]
  memberships             Membership[]
  invitations             Invitation[]
  sessions                Session[]
  auditLogs               AuditLog[]
  subscription            Subscription?
  clients                 Client[]
  cases                   Case[]
  partyRegistry           PartyRegistry[]
  customFieldDefs         CustomFieldDef[]
  letterheads             Letterhead[]
  caseImportBatches       CaseImportBatch[]
  documents               Document[]
  tasks                   Task[]
  deadlines               Deadline[]
  aiUsage                 AiUsage[]
  documentTexts           DocumentText[]
  agendaEvents            AgendaEvent[]
  notifications           Notification[]
  timeEntries             TimeEntry[]
  courtNotices            CourtNotice[]
  documentTemplates       DocumentTemplate[]
  documentVersions        DocumentVersion[]
  petitionFilings         PetitionFiling[]
  petitionAttachments     PetitionAttachment[]
  textSnippets            TextSnippet[]
  apiKeys                 ApiKey[]
  webhookEndpoints        WebhookEndpoint[]
  leads                   Lead[]
  proposals               Proposal[]
  workflowRules           WorkflowRule[]
  portalAccounts          PortalAccount[]
  importMaps              ImportMap[]
  financeAccounts         FinanceAccount[]
  financeCategories       FinanceCategory[]
  costCenters             CostCenter[]
  financeEntries          FinanceEntry[]
  feeInvoices             FeeInvoice[]
  caseFees                CaseFee[]
  caseLinks               CaseLink[]
  linkedDocuments         LinkedDocument[]
  caseAppeals             CaseAppeal[]
  financePayments         FinancePayment[]
  whatsappAccounts        WhatsappAccount[]
  whatsappConversations   WhatsappConversation[]
  whatsappMessages        WhatsappMessage[]
  whatsappQuickReplies    WhatsappQuickReply[]
  whatsappTemplates       WhatsappTemplate[]
  whatsappQueues          WhatsappQueue[]
  whatsappLabels          WhatsappLabel[]
  whatsappFields          WhatsappField[]
  whatsappAutomations     WhatsappAutomation[]
  whatsappBot             WhatsappBot?
  whatsappBillingSettings WhatsappBillingSettings?
  whatsappBillingSends    WhatsappBillingSend[]
  whatsappBillingOptouts  WhatsappBillingOptout[]
  whatsappAgents          WhatsappAgent[]
  whatsappSlaSettings     WhatsappSlaSettings?
  whatsappSlaAlerts       WhatsappSlaAlert[]
  pushSettings            PushSettings?
  pushSubscriptions       PushSubscription[]
  pushPreferences         PushPreference[]
  announcements           Announcement[]

  @@map("organizations")
}

model Role {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  key            String
  name           String
  description    String?
  permissions    String[]
  isSystem       Boolean  @default(false) @map("is_system")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships  Membership[]
  invitations  Invitation[]

  @@unique([organizationId, key])
  @@map("roles")
}

model Membership {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  roleId         String           @map("role_id") @db.Uuid
  status         MembershipStatus @default(ACTIVE)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([roleId])
  @@map("memberships")
}

model Invitation {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  email          String
  roleId         String    @map("role_id") @db.Uuid
  tokenHash      String    @unique @map("token_hash")
  invitedById    String?   @map("invited_by_id") @db.Uuid
  acceptedById   String?   @map("accepted_by_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(3)
  acceptedAt     DateTime? @map("accepted_at") @db.Timestamptz(3)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(3)
  clientId       String?   @map("client_id") @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id], onDelete: Restrict)

  // Índice único parcial (1 convite pendente por e-mail/escritório) existe apenas no SQL da migration.
  @@index([organizationId, email])
  @@map("invitations")
}

model Plan {
  id               String   @id @default(uuid()) @db.Uuid
  key              String   @unique
  name             String
  description      String?
  maxUsers         Int?     @map("max_users")
  maxStorageMb     Int?     @map("max_storage_mb")
  maxAiTokensMonth Int?     @map("max_ai_tokens_month")
  features         String[]
  priceCents       Int?     @map("price_cents")
  isPublic         Boolean  @default(true) @map("is_public")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id                     String             @id @default(uuid()) @db.Uuid
  organizationId         String             @unique @map("organization_id") @db.Uuid
  planId                 String             @map("plan_id") @db.Uuid
  status                 SubscriptionStatus @default(TRIALING)
  trialEndsAt            DateTime?          @map("trial_ends_at") @db.Timestamptz(3)
  currentPeriodEnd       DateTime?          @map("current_period_end") @db.Timestamptz(3)
  // Sem provedor de cobrança integrado: nenhum identificador externo é preenchido na Fase 1.
  providerReference      String?            @map("provider_reference")
  billingProvider        String?            @map("billing_provider")
  providerCustomerId     String?            @map("provider_customer_id")
  providerSubscriptionId String?            @unique @map("provider_subscription_id")
  cancelRequestedAt      DateTime?          @map("cancel_requested_at") @db.Timestamptz(3)
  billingName            String?            @map("billing_name")
  billingDocument        String?            @map("billing_document")
  billingEmail           String?            @map("billing_email")
  createdAt              DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan         Plan         @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@map("subscriptions")
}

model AuditLog {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String?     @map("organization_id") @db.Uuid
  userId         String?     @map("user_id") @db.Uuid
  action         String
  resourceType   String?     @map("resource_type")
  resourceId     String?     @map("resource_id")
  result         AuditResult @default(SUCCESS)
  ipAddress      String?     @map("ip_address")
  userAgent      String?     @map("user_agent")
  correlationId  String?     @map("correlation_id")
  metadata       Json?
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([action])
  @@map("audit_logs")
}

// ============================ Fase 2: clientes e processos ============================
// Observação: a migration SQL acrescenta FKs compostas (id, organization_id) como defesa em profundidade
// multi-tenant; aqui as relações são declaradas por `id` (o Prisma não precisa conhecer as FKs extras).

enum ClientType {
  PERSON
  COMPANY
}

enum ClientStatus {
  PROSPECT
  ACTIVE
  INACTIVE
}

enum CaseStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
  CLOSED
}

enum PartyRole {
  PLAINTIFF
  DEFENDANT
  THIRD_PARTY
  OTHER
}

enum CaseMemberRole {
  RESPONSIBLE
  COLLABORATOR
}

enum EventSource {
  IMPORTED
  INTERNAL
  AUTOMATIC
}

model Client {
  id                String       @id @default(uuid()) @db.Uuid
  organizationId    String       @map("organization_id") @db.Uuid
  type              ClientType
  status            ClientStatus @default(ACTIVE)
  name              String
  tradeName         String?      @map("trade_name")
  document          String?
  email             String?
  phone             String?
  birthDate         DateTime?    @map("birth_date") @db.Date
  tags              String[]
  notes             String?
  addressZip        String?      @map("address_zip")
  addressStreet     String?      @map("address_street")
  addressNumber     String?      @map("address_number")
  addressComplement String?      @map("address_complement")
  addressDistrict   String?      @map("address_district")
  addressCity       String?      @map("address_city")
  addressState      String?      @map("address_state")
  createdById       String?      @map("created_by_id") @db.Uuid
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt         DateTime?    @map("deleted_at") @db.Timestamptz(3)

  organization          Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contacts              ClientContact[]
  parties               CaseParty[]
  documents             Document[]
  tasks                 Task[]
  kanbanCards           KanbanCard[]
  agendaEvents          AgendaEvent[]
  whatsappConversations WhatsappConversation[]

  @@map("clients")
  vaultCredentials ClientCredential[]
}

model ClientContact {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  clientId       String   @map("client_id") @db.Uuid
  name           String
  role           String?
  email          String?
  phone          String?
  isPrimary      Boolean  @default(false) @map("is_primary")
  notes          String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([organizationId])
  @@map("client_contacts")
}

model Case {
  id             String     @id @default(uuid()) @db.Uuid
  organizationId String     @map("organization_id") @db.Uuid
  number         String?
  legacyNumber   String?    @map("legacy_number")
  title          String
  area           String?
  court          String?
  courtUnit      String?    @map("court_unit")
  courtState     String?    @map("court_state")
  subject        String?
  claimValue     Decimal?   @map("claim_value") @db.Decimal(14, 2)
  status         CaseStatus @default(ACTIVE)
  phase          String?
  distributedAt  DateTime?  @map("distributed_at") @db.Date
  confidential   Boolean    @default(false)
  notes          String?
  createdById    String?    @map("created_by_id") @db.Uuid
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt      DateTime?  @map("deleted_at") @db.Timestamptz(3)

  organization          Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parties               CaseParty[]
  members               CaseMember[]
  events                CaseEvent[]
  whatsappConversations WhatsappConversation[] @relation("WhatsappCase")
  documents             Document[]
  tasks                 Task[]
  kanbanCards           KanbanCard[]
  deadlines             Deadline[]
  courtNotices          CourtNotice[]
  agendaEvents          AgendaEvent[]
  petitions             PetitionFiling[]
  sharedWithPortal      Boolean                @default(false) @map("shared_with_portal")
  datajudSyncedAt       DateTime?              @map("datajud_synced_at") @db.Timestamptz(3)
  /// 3.0-F1: acervo (processo guardado fora da carteira ativa, sem exclusão).
  archivedAt            DateTime?              @map("archived_at") @db.Timestamptz(3)
  /// 3.0-F1: valores dos campos personalizados, chaveados por CustomFieldDef.key.
  customFields          Json                   @default("{}") @map("custom_fields")
  caseNotes             CaseNote[]
  /// 2.0-F5: provisão e correção monetária (estimativa; índices em monetary_indices).
  provisionValue        Decimal?               @map("provision_value") @db.Decimal(14, 2)
  provisionBaseDate     DateTime?              @map("provision_base_date") @db.Date
  claimBaseDate         DateTime?              @map("claim_base_date") @db.Date
  correctionIndex       String?                @map("correction_index")
  fees                  CaseFee[]
  appeals               CaseAppeal[]

  @@index([organizationId, archivedAt])
  @@map("cases")
}

model CaseParty {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  caseId         String    @map("case_id") @db.Uuid
  clientId       String?   @map("client_id") @db.Uuid
  role           PartyRole
  name           String
  document       String?
  lawyerName     String?   @map("lawyer_name")
  isOurClient    Boolean   @default(false) @map("is_our_client")
  /// 3.0-F1: vínculo com o cadastro único de partes (opcional).
  registryId     String?   @map("registry_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  case     Case           @relation(fields: [caseId], references: [id], onDelete: Cascade)
  client   Client?        @relation(fields: [clientId], references: [id], onDelete: Restrict)
  registry PartyRegistry? @relation(fields: [registryId], references: [id], onDelete: SetNull)

  @@index([caseId])
  @@index([organizationId])
  @@map("case_parties")
}

model CaseMember {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  caseId         String         @map("case_id") @db.Uuid
  userId         String         @map("user_id") @db.Uuid
  role           CaseMemberRole @default(COLLABORATOR)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([caseId, userId])
  @@index([userId])
  @@index([organizationId])
  @@map("case_members")
}

model CaseEvent {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  caseId         String      @map("case_id") @db.Uuid
  source         EventSource
  kind           String
  title          String
  description    String?
  occurredAt     DateTime    @default(now()) @map("occurred_at") @db.Timestamptz(3)
  externalKey    String?     @map("external_key")
  createdById    String?     @map("created_by_id") @db.Uuid
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId, occurredAt(sort: Desc)])
  @@index([organizationId])
  @@map("case_events")
}

model Document {
  id               String    @id @default(uuid()) @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  caseId           String?   @map("case_id") @db.Uuid
  clientId         String?   @map("client_id") @db.Uuid
  name             String
  mimeType         String    @map("mime_type")
  sizeBytes        Int       @map("size_bytes")
  sha256           String
  storageKey       String    @unique @map("storage_key")
  uploadedById     String?   @map("uploaded_by_id") @db.Uuid
  category         String?
  description      String?
  currentVersion   Int       @default(1) @map("current_version")
  templateId       String?   @map("template_id") @db.Uuid
  sharedWithPortal Boolean   @default(false) @map("shared_with_portal")
  sharedAt         DateTime? @map("shared_at") @db.Timestamptz(3)
  externalKey      String?   @map("external_key")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(3)

  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  case                Case?                @relation(fields: [caseId], references: [id], onDelete: Restrict)
  client              Client?              @relation(fields: [clientId], references: [id], onDelete: Restrict)
  template            DocumentTemplate?    @relation(fields: [templateId], references: [id], onDelete: Restrict)
  versions            DocumentVersion[]
  petitions           PetitionFiling[]
  petitionAttachments PetitionAttachment[]
  texts               DocumentText[]
  driveLink           DocumentDriveLink?
  classifications     DocumentClassification[]

  @@unique([organizationId, externalKey])
  @@index([organizationId])
  @@map("documents")
}

// ============================ Fase 3: tarefas, prazos, agenda, notificações ============================

enum TaskStatus {
  TODO
  IN_PROGRESS
  WAITING
  DONE
  CANCELED
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum DeadlineStatus {
  DRAFT
  VALIDATED
  FULFILLED
  CANCELED
}

enum DeadlineSource {
  MANUAL
  IMPORTED
}

enum DeadlineCountType {
  BUSINESS
  CALENDAR
}

enum AgendaEventKind {
  HEARING
  MEETING
  DILIGENCE
  OTHER
}

model Task {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  title          String
  description    String?
  status         TaskStatus   @default(TODO)
  priority       TaskPriority @default(NORMAL)
  dueDate        DateTime?    @map("due_date") @db.Date
  assigneeId     String?      @map("assignee_id") @db.Uuid
  caseId         String?      @map("case_id") @db.Uuid
  clientId       String?      @map("client_id") @db.Uuid
  createdById    String?      @map("created_by_id") @db.Uuid
  completedAt    DateTime?    @map("completed_at") @db.Timestamptz(3)
