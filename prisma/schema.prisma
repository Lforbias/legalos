  @@map("credit_usages")
}

/// 3.0-F6b: credencial de acesso a um sistema de tribunal, por usuário (e por tribunal; courtCode vazio = todos). Segredo cifrado.
model CourtCredential {
  id            String    @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  system        String
