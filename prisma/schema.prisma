}

/// Box 2.0: uma tentativa de envio de petição (histórico que impede reenvio às cegas).
model PetitionAttempt {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  petitionId     String    @map("petition_id") @db.Uuid
  attemptNo      Int       @map("attempt_no")
  adapter        String
  environment    String
  manifestSha256 String    @map("manifest_sha256")
  idempotencyKey String    @map("idempotency_key")
  outcome        String    @default("STARTED")
  errorCode      String?   @map("error_code")
  errorMessage   String?   @map("error_message")
  startedById    String?   @map("started_by_id") @db.Uuid
  startedAt      DateTime  @default(now()) @map("started_at") @db.Timestamptz(3)
  finishedAt     DateTime? @map("finished_at") @db.Timestamptz(3)
  resolution     String?
  resolvedById   String?   @map("resolved_by_id") @db.Uuid
  resolvedAt     DateTime? @map("resolved_at") @db.Timestamptz(3)

  @@unique([petitionId, attemptNo])
  @@index([organizationId, petitionId])
  @@map("petition_attempts")
}

/// Box 2.0: recibo / prova do protocolo (no máximo um por petição).
model PetitionReceipt {
  id                String    @id @default(uuid()) @db.Uuid
  organizationId    String    @map("organization_id") @db.Uuid
  petitionId        String    @unique @map("petition_id") @db.Uuid
  attemptId         String?   @map("attempt_id") @db.Uuid
  source            String
  environment       String
  protocol          String
  receiptText       String?   @map("receipt_text")
  receiptSha256     String?   @map("receipt_sha256")
  receiptDocumentId String?   @map("receipt_document_id") @db.Uuid
  filedAt           DateTime? @map("filed_at") @db.Timestamptz(3)
  recordedById      String?   @map("recorded_by_id") @db.Uuid
  note              String?
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([organizationId, createdAt(sort: Desc)])
  @@map("petition_receipts")
}

// Revisão editorial interna, independente do protocolo judicial.
model DocumentReview {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  documentId String @map("document_id") @db.Uuid
  version Int
  status String @default("IN_REVIEW")
  requestedById String @map("requested_by_id") @db.Uuid
  reviewedById String? @map("reviewed_by_id") @db.Uuid
  note String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  reviewedAt DateTime? @map("reviewed_at") @db.Timestamptz(3)
