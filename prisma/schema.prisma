// LegalOS — schema da Fase 1 (fundação multiempresa).
// Convenção: tabelas e colunas em snake_case (via @map), datas em UTC, IDs uuid.
// Toda entidade pertencente a um escritório carrega organization_id.

generator client {
  provider        = "prisma-client-js"
  engineType      = "client"
  previewFeatures = ["queryCompiler", "driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
}

enum EmailTokenType {
  VERIFY_EMAIL
  PASSWORD_RESET
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

enum AuditResult {
  SUCCESS
  FAILURE
  DENIED
}

model User {
  courtOtpAuthenticators CourtOtpAuthenticator[]
  pjeDiscoveries PjeDiscovery[]
  portalAccesses PortalAccess[]
  id                      String    @id @default(uuid()) @db.Uuid
  email                   String    @unique
  name                    String
  passwordHash            String    @map("password_hash")
  emailVerifiedAt         DateTime? @map("email_verified_at") @db.Timestamptz(3)
  locale                  String    @default("pt-BR")
  timezone                String    @default("America/Sao_Paulo")
  notificationPreferences Json      @default("{}") @map("notification_preferences")
  disabledAt              DateTime? @map("disabled_at") @db.Timestamptz(3)
  lastLoginAt             DateTime? @map("last_login_at") @db.Timestamptz(3)
  failedLoginCount        Int       @default(0) @map("failed_login_count")
  lockedUntil             DateTime? @map("locked_until") @db.Timestamptz(3)
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions          Session[]
  emailTokens       EmailToken[]
  memberships       Membership[]
  auditLogs         AuditLog[]
  caseMembers       CaseMember[]
  notifications     Notification[]
  timeEntries       TimeEntry[]
  mfa               UserMfa?
  platformAdmin     PlatformAdmin?
  comMember         ComMember?
  ownedCertificates Certificate[]     @relation("CertificateOwner")
  mfaRecoveryCodes  MfaRecoveryCode[]
  mfaChallenges     MfaChallenge[]

  whatsappAssigned  WhatsappConversation[] @relation("WhatsappAssignee")
  whatsappAgents    WhatsappAgent[]
  whatsappAuthored  WhatsappMessage[]      @relation("WhatsappAuthor")
  pushSubscriptions PushSubscription[]
  pushPreferences   PushPreference[]
  pushDeliveries    PushDelivery[]

  @@map("users")
}

model Session {
  id                   String    @id @default(uuid()) @db.Uuid
  userId               String    @map("user_id") @db.Uuid
  tokenHash            String    @unique @map("token_hash")
  activeOrganizationId String?   @map("active_organization_id") @db.Uuid
  userAgent            String?   @map("user_agent")
  ipAddress            String?   @map("ip_address")
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt           DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  expiresAt            DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt            DateTime? @map("revoked_at") @db.Timestamptz(3)

  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganization Organization? @relation(fields: [activeOrganizationId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("sessions")
}

model EmailToken {
  id        String         @id @default(uuid()) @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  type      EmailTokenType
  tokenHash String         @unique @map("token_hash")
  expiresAt DateTime       @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime?      @map("used_at") @db.Timestamptz(3)
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("email_tokens")
}

model LegalMailPilot {
  singleton      Boolean      @id @default(true)
  organizationId String       @map("organization_id") @db.Uuid
  apiKeyEnc      String?      @map("api_key_enc")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("legalmail_pilot")
}

