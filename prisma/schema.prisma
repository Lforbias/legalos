model Certificate {
  id                String    @id @default(uuid()) @db.Uuid
  organizationId    String    @map("organization_id") @db.Uuid
  ownerUserId       String    @map("owner_user_id") @db.Uuid
  label             String
  subjectCn         String    @map("subject_cn")
  documentHint      String?   @map("document_hint")
  issuerCn          String?   @map("issuer_cn")
  serialNumber      String    @map("serial_number")
  fingerprintSha256 String    @map("fingerprint_sha256")
  notBefore         DateTime  @map("not_before") @db.Timestamptz(3)
  notAfter          DateTime  @map("not_after") @db.Timestamptz(3)
  pfxEnc            String    @map("pfx_enc")
  passEnc           String    @map("pass_enc")
  createdById       String?   @map("created_by_id") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokedById       String?   @map("revoked_by_id") @db.Uuid
  lastUsedAt        DateTime? @map("last_used_at") @db.Timestamptz(3)

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner        User               @relation("CertificateOwner", fields: [ownerUserId], references: [id])
  usage        CertificateUsage[]
  connections  CourtConnection[]
  authorized   CertificateAuthorizedUser[]
  credentials  CourtCredential[]

  @@unique([organizationId, fingerprintSha256])
  @@index([organizationId, revokedAt])
  @@map("certificates")
}

