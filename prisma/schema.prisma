/// Acesso do usuário a um portal de tribunal (PJe etc.) usado pelo robô: um registro por usuário, sistema e tribunal/grau.
/// O segredo (senha, chave do 2º fator) fica cifrado em `secretEnc`; nunca volta para tela ou API.
model PortalAccess {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  system         String    @default("pje")
  target         String
  label          String
  authMethod     String    @map("auth_method")
  certificateId  String?   @map("certificate_id") @db.Uuid
  secretEnc      String    @map("secret_enc")
  enabled        Boolean   @default(true)
  status         String    @default("PENDING")
  statusMessage  String?   @map("status_message")
  statusAt       DateTime? @map("status_at") @db.Timestamptz(3)
  lastLoginAt    DateTime? @map("last_login_at") @db.Timestamptz(3)
  lastSyncAt     DateTime? @map("last_sync_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  certificate  Certificate? @relation(fields: [certificateId], references: [id], onDelete: SetNull)
  jobs         RobotJob[]

  @@unique([organizationId, userId, system, target])
  @@index([organizationId, userId])
  @@map("portal_accesses")
}

/// Fila de trabalhos do robô de tribunais (o worker pega com SKIP LOCKED). `summary` guarda contagens, a "assinatura" da tela
/// (endereço sem parâmetros, títulos e nomes de campos) e etapas sanitizadas do login, nunca conteúdo de processos nem segredos.
model RobotJob {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  accessId       String    @map("access_id") @db.Uuid
  kind           String
  status         String    @default("QUEUED")
  attempts       Int       @default(0)
  runAfter       DateTime  @default(now()) @map("run_after") @db.Timestamptz(3)
  startedAt      DateTime? @map("started_at") @db.Timestamptz(3)
  finishedAt     DateTime? @map("finished_at") @db.Timestamptz(3)
  message        String?
  summary        Json      @default("{}")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  access       PortalAccess @relation(fields: [accessId], references: [id], onDelete: Cascade)

  @@index([status, runAfter])
  @@index([accessId, createdAt(sort: Desc)])
  @@map("robot_jobs")
}


// ───────── Box 2.0 — base estrutural (migração 20270106000000_box_v2_foundation) ─────────
// Sem relações Prisma: as chaves estrangeiras existem no SQL; os serviços sempre filtram por organizationId.

/// Identidade profissional (inscrição na OAB). Um escritório pode ter vários profissionais e várias inscrições.
model ProfessionalIdentity {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  userId         String?  @map("user_id") @db.Uuid
  name           String
  oabNumber      String   @map("oab_number")
  oabUf          String   @map("oab_uf")
  notifyEmail    String?  @map("notify_email")
  active         Boolean  @default(true)
  createdById    String?  @map("created_by_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([organizationId, oabUf, oabNumber])
  @@index([organizationId, active])
  @@map("professional_identities")
}

/// Uma execução de sincronização de uma fonte. No máximo uma em andamento por fonte (índice único parcial no SQL).
model SyncRun {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  sourceKind     String    @map("source_kind")
  sourceId       String    @map("source_id") @db.Uuid
  trigger        String    @default("CRON")
  status         String    @default("RUNNING")
  startedAt      DateTime  @default(now()) @map("started_at") @db.Timestamptz(3)
  heartbeatAt    DateTime  @default(now()) @map("heartbeat_at") @db.Timestamptz(3)
  finishedAt     DateTime? @map("finished_at") @db.Timestamptz(3)
  windowFrom     DateTime? @map("window_from") @db.Date
  windowTo       DateTime? @map("window_to") @db.Date
  cursor         Json?
  pages          Int       @default(0)
  fetched        Int       @default(0)
  reportedTotal  Int?      @map("reported_total")
  createdCount   Int       @default(0) @map("created_count")
  duplicateCount Int       @default(0) @map("duplicate_count")
  skippedCount   Int       @default(0) @map("skipped_count")
  errorCode      String?   @map("error_code")
  errorMessage   String?   @map("error_message")
  coverage       String?

  @@index([organizationId, sourceKind, sourceId, startedAt(sort: Desc)])
  @@index([status, heartbeatAt])
  @@map("sync_runs")
}

/// Evidência de funcionamento por tribunal × operação × método. É a única base para um conector aparecer como operacional.
model ConnectorEvidence {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  sourceKind     String?  @map("source_kind")
  sourceId       String?  @map("source_id") @db.Uuid
  connectorKey   String   @map("connector_key")
  courtCode      String   @default("*") @map("court_code")
  operation      String
  accessMethod   String   @map("access_method")
  environment    String   @default("PRODUCTION")
  outcome        String
  reasonCode     String?  @map("reason_code")
  summary        String?
  details        Json     @default("{}")
  runId          String?  @map("run_id") @db.Uuid
  checkedById    String?  @map("checked_by_id") @db.Uuid
  checkedAt      DateTime @default(now()) @map("checked_at") @db.Timestamptz(3)

  @@index([organizationId, connectorKey, courtCode, operation, checkedAt(sort: Desc)])
  @@index([sourceKind, sourceId, checkedAt(sort: Desc)])
  @@map("connector_evidences")
}

/// Alerta de saúde persistente (abre, é reconhecido, é resolvido). Deduplicado por (organização, dedupeKey).
model HealthAlert {
  id               String    @id @default(uuid()) @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  sourceKind       String?   @map("source_kind")
  sourceId         String?   @map("source_id") @db.Uuid
  code             String
  severity         String
  title            String
  body             String?
  state            String    @default("OPEN")
  dedupeKey        String    @map("dedupe_key")
  occurrences      Int       @default(1)
  details          Json      @default("{}")
  firstSeenAt      DateTime  @default(now()) @map("first_seen_at") @db.Timestamptz(3)
  lastSeenAt       DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  acknowledgedById String?   @map("acknowledged_by_id") @db.Uuid
  acknowledgedAt   DateTime? @map("acknowledged_at") @db.Timestamptz(3)
  resolvedAt       DateTime? @map("resolved_at") @db.Timestamptz(3)

  @@unique([organizationId, dedupeKey])
  @@index([organizationId, state, severity])
  @@map("health_alerts")
}

/// Histórico e evidência de cada comunicação: captura, visualização no LegalOS, ciência oficial, atribuição...
model NoticeEvent {
