  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key])
  @@map("custom_field_defs")
}

/// Nota interna do processo: pode ser fixada no topo e aplicada em vários processos de uma vez (bulkId).
model CaseNote {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  caseId         String   @map("case_id") @db.Uuid
  authorId       String?  @map("author_id") @db.Uuid
  title          String?
  body           String
  pinned         Boolean  @default(false)
  bulkId         String?  @map("bulk_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  case        Case               @relation(fields: [caseId], references: [id], onDelete: Cascade)
  attachments CaseNoteAttachment[]

  @@index([caseId, pinned, createdAt(sort: Desc)])
  @@index([organizationId])
  @@map("case_notes")
}

