model Role {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  key            String
  name           String
  description    String?
  permissions    String[]
  isSystem       Boolean  @default(false) @map("is_system")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships  Membership[]
  invitations  Invitation[]

  @@unique([organizationId, key])
  @@map("roles")
}

model Membership {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  roleId         String           @map("role_id") @db.Uuid
  status         MembershipStatus @default(ACTIVE)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([roleId])
  @@map("memberships")
}

model Invitation {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  email          String
  roleId         String    @map("role_id") @db.Uuid
  tokenHash      String    @unique @map("token_hash")
  invitedById    String?   @map("invited_by_id") @db.Uuid
  acceptedById   String?   @map("accepted_by_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(3)
  acceptedAt     DateTime? @map("accepted_at") @db.Timestamptz(3)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(3)
  clientId       String?   @map("client_id") @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id], onDelete: Restrict)

  // Índice único parcial (1 convite pendente por e-mail/escritório) existe apenas no SQL da migration.
  @@index([organizationId, email])
  @@map("invitations")
}

model Plan {
  id               String   @id @default(uuid()) @db.Uuid
  key              String   @unique
  name             String
  description      String?
  maxUsers         Int?     @map("max_users")
  maxStorageMb     Int?     @map("max_storage_mb")
  maxAiTokensMonth Int?     @map("max_ai_tokens_month")
  features         String[]
  priceCents       Int?     @map("price_cents")
  isPublic         Boolean  @default(true) @map("is_public")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id                     String             @id @default(uuid()) @db.Uuid
  organizationId         String             @unique @map("organization_id") @db.Uuid
  planId                 String             @map("plan_id") @db.Uuid
  status                 SubscriptionStatus @default(TRIALING)
  trialEndsAt            DateTime?          @map("trial_ends_at") @db.Timestamptz(3)
  currentPeriodEnd       DateTime?          @map("current_period_end") @db.Timestamptz(3)
  // Sem provedor de cobrança integrado: nenhum identificador externo é preenchido na Fase 1.
  providerReference      String?            @map("provider_reference")
  billingProvider        String?            @map("billing_provider")
  providerCustomerId     String?            @map("provider_customer_id")
  providerSubscriptionId String?            @unique @map("provider_subscription_id")
  cancelRequestedAt      DateTime?          @map("cancel_requested_at") @db.Timestamptz(3)
  billingName            String?            @map("billing_name")
  billingDocument        String?            @map("billing_document")
  billingEmail           String?            @map("billing_email")
  createdAt              DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan         Plan         @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@map("subscriptions")
}

model AuditLog {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String?     @map("organization_id") @db.Uuid
  userId         String?     @map("user_id") @db.Uuid
  action         String
  resourceType   String?     @map("resource_type")
  resourceId     String?     @map("resource_id")
  result         AuditResult @default(SUCCESS)
  ipAddress      String?     @map("ip_address")
  userAgent      String?     @map("user_agent")
  correlationId  String?     @map("correlation_id")
  metadata       Json?
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([action])
  @@map("audit_logs")
}

// ============================ Fase 2: clientes e processos ============================
// Observação: a migration SQL acrescenta FKs compostas (id, organization_id) como defesa em profundidade
// multi-tenant; aqui as relações são declaradas por `id` (o Prisma não precisa conhecer as FKs extras).

enum ClientType {
  PERSON
  COMPANY
}

enum ClientStatus {
  PROSPECT
  ACTIVE
  INACTIVE
}

enum CaseStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
  CLOSED
}

enum PartyRole {
  PLAINTIFF
  DEFENDANT
  THIRD_PARTY
  OTHER
}

enum CaseMemberRole {
  RESPONSIBLE
  COLLABORATOR
}

enum EventSource {
  IMPORTED
  INTERNAL
  AUTOMATIC
}

model Client {
  id                String       @id @default(uuid()) @db.Uuid
  organizationId    String       @map("organization_id") @db.Uuid
  type              ClientType
  status            ClientStatus @default(ACTIVE)
  name              String
  tradeName         String?      @map("trade_name")
  document          String?
  email             String?
  phone             String?
  birthDate         DateTime?    @map("birth_date") @db.Date
  tags              String[]
  notes             String?
  addressZip        String?      @map("address_zip")
  addressStreet     String?      @map("address_street")
  addressNumber     String?      @map("address_number")
  addressComplement String?      @map("address_complement")
  addressDistrict   String?      @map("address_district")
  addressCity       String?      @map("address_city")
  addressState      String?      @map("address_state")
  createdById       String?      @map("created_by_id") @db.Uuid
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt         DateTime?    @map("deleted_at") @db.Timestamptz(3)

  organization          Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contacts              ClientContact[]
  parties               CaseParty[]
  documents             Document[]
  tasks                 Task[]
  kanbanCards           KanbanCard[]
  agendaEvents          AgendaEvent[]
  whatsappConversations WhatsappConversation[]
  vaultCredentials      ClientCredential[]
  driveFolder           ClientDriveFolder?

  @@map("clients")
}

model ClientDriveFolder {
  clientId    String  @id @map("client_id") @db.Uuid
  folderId    String  @map("folder_id")
  name        String
  resourceKey String? @map("resource_key")
  client      Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@map("client_drive_folders")
}

model ClientContact {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  clientId       String   @map("client_id") @db.Uuid
  name           String
  role           String?
  email          String?
  phone          String?
  isPrimary      Boolean  @default(false) @map("is_primary")
  notes          String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([organizationId])
  @@map("client_contacts")
}

model CaseDepartment {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  name String
  area String
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  cases Case[]
  @@unique([organizationId, area])
  @@map("case_departments")
}

model Case {
  pjeDiscoveries PjeDiscovery[]
  id             String     @id @default(uuid()) @db.Uuid
  organizationId String     @map("organization_id") @db.Uuid
  number         String?
  nature String @default("CASE")
  departmentId String? @map("department_id") @db.Uuid
  department CaseDepartment? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  legacyNumber   String?    @map("legacy_number")
  courtSystem    String?    @map("court_system")
  title          String
  area           String?
  court          String?
  courtUnit      String?    @map("court_unit")
  courtState     String?    @map("court_state")
  subject        String?
  claimValue     Decimal?   @map("claim_value") @db.Decimal(14, 2)
  status         CaseStatus @default(ACTIVE)
  phase          String?
  distributedAt  DateTime?  @map("distributed_at") @db.Date
  confidential   Boolean    @default(false)
  notes          String?
  createdById    String?    @map("created_by_id") @db.Uuid
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt      DateTime?  @map("deleted_at") @db.Timestamptz(3)

  organization          Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parties               CaseParty[]
  members               CaseMember[]
  events                CaseEvent[]
  whatsappConversations WhatsappConversation[] @relation("WhatsappCase")
  documents             Document[]
  tasks                 Task[]
  kanbanCards           KanbanCard[]
  deadlines             Deadline[]
  courtNotices          CourtNotice[]
  agendaEvents          AgendaEvent[]
  petitions             PetitionFiling[]
  sharedWithPortal      Boolean                @default(false) @map("shared_with_portal")
  datajudSyncedAt       DateTime?              @map("datajud_synced_at") @db.Timestamptz(3)
  datajudClass          String?                @map("datajud_class")
  datajudCourtUnit      String?                @map("datajud_court_unit")
  /// 3.0-F1: acervo (processo guardado fora da carteira ativa, sem exclusão).
  archivedAt            DateTime?              @map("archived_at") @db.Timestamptz(3)
  /// 3.0-F1: valores dos campos personalizados, chaveados por CustomFieldDef.key.
  customFields          Json                   @default("{}") @map("custom_fields")
  caseNotes             CaseNote[]
  /// 2.0-F5: provisão e correção monetária (estimativa; índices em monetary_indices).
  provisionValue        Decimal?               @map("provision_value") @db.Decimal(14, 2)
  provisionBaseDate     DateTime?              @map("provision_base_date") @db.Date
  claimBaseDate         DateTime?              @map("claim_base_date") @db.Date
  correctionIndex       String?                @map("correction_index")
  fees                  CaseFee[]
  appeals               CaseAppeal[]

  @@index([organizationId, departmentId, nature])
  @@index([organizationId, archivedAt])
  @@map("cases")
}

model CaseParty {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  caseId         String    @map("case_id") @db.Uuid
