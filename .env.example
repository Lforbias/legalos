# --- Banco de dados (PostgreSQL) ---
DATABASE_URL="postgresql://legalos:legalos_dev@localhost:5432/legalos"
# Banco usado pelos testes de integração (é recriado/limpo pelos testes!)
TEST_DATABASE_URL="postgresql://legalos:legalos_dev@localhost:5432/legalos_test"

# --- Aplicação ---
# URL pública usada para montar links de convite e de recuperação de senha
APP_URL="http://localhost:3000"
# development | production | test (definido automaticamente pelo Next.js)
# LOG_LEVEL=info

# --- Documentos ---
# Diretório de armazenamento de arquivos enviados (padrão: ./.storage). Deve ser privado e persistente (backup!).
# STORAGE_DIR=./.storage

# --- Limites de taxa ---
# Multiplicador dos limites de autenticação (padrão 1). Usado só nos testes E2E; não aumente em produção.
# RATE_LIMIT_MULTIPLIER=1

# --- E-mail ---
# MAIL_DRIVER=console   # console (padrão): NÃO entrega, só registra no log | smtp: entrega de verdade
# Para entregar e-mail (convites, confirmação de e-mail, recuperação de senha), use um provedor SMTP
# (o do seu domínio, Google Workspace, Amazon SES, Brevo, etc.) e preencha:
# MAIL_DRIVER=smtp
# SMTP_HOST=smtp.seuprovedor.com
# SMTP_PORT=587          # 587 (STARTTLS, padrão) ou 465 com SMTP_SECURE=true
# SMTP_SECURE=false
# SMTP_USER=usuario
# SMTP_PASS=senha-ou-chave-de-app
# MAIL_FROM=LegalOS <nao-responda@seudominio.com.br>   # use um remetente do seu domínio com SPF/DKIM configurados
# Teste: npm run mail-test -- seu@email.com

# --- Somente para ambientes SEM acesso a binaries.prisma.sh (ex.: sandboxes com egress restrito) ---
# O LegalOS usa o engine "client" do Prisma + driver adapter pg (sem binários Rust em runtime), mas o
# CLI ainda tenta baixar engines no `prisma generate`. Estas variáveis pulam esse download desnecessário.
# PRISMA_SCHEMA_ENGINE_BINARY=/bin/true
# PRISMA_QUERY_ENGINE_LIBRARY=/bin/true

# --- Peticionamento ---
# Adaptador de protocolo. Hoje só existe "demo" (NÃO protocola em tribunal algum; gera recibo marcado como demonstração).
# PETITIONING_ADAPTER=demo

# --- Inteligência artificial (Fase 8a) ---
# Sem a chave o assistente fica DESLIGADO (nenhuma resposta é simulada). Ligue também no escritório em /ia.
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-sonnet-4-5
# Limite mensal de tokens (entrada + saída) por escritório (padrão 500000)
# AI_MONTHLY_TOKEN_LIMIT=500000

# --- OCR e leitura de documentos (Fase 8b) ---
# Usa programas instalados no servidor (nenhum serviço externo): tesseract + poppler.
#   macOS:  brew install tesseract tesseract-lang poppler
#   Ubuntu: apt install tesseract-ocr tesseract-ocr-por poppler-utils
# Idiomas do OCR (padrão por+eng; usa só os instalados) e limite de páginas por documento (padrão 30)
# OCR_LANGS=por+eng
# OCR_MAX_PAGES=30

# Fase 8c: consulta DataJud/CNJ. Chave pública publicada pelo CNJ (wiki do DataJud). Sem ela a função fica DESLIGADA. Ligue também no escritório em /integracoes.
# DATAJUD_API_KEY=
# DATAJUD_BASE_URL=https://api-publica.datajud.cnj.jus.br

# --- Fase 9a: verificação em duas etapas (MFA/TOTP) ---
# Chave de 32 bytes em base64 que cifra os segredos TOTP no banco. Gere com:  openssl rand -base64 32
# Sem ela o 2FA fica indisponível (aviso na página Minha conta). GUARDE esta chave: se for perdida, todos
# precisarão refazer o cadastro do 2FA. Não a coloque no Git.
# MFA_ENCRYPTION_KEY=

# --- Fase 9b: backups (scripts/backup.sh) ---
# BACKUP_DIR=/caminho/fora/do/app
# BACKUP_PASSPHRASE=        # criptografa os backups; guarde fora do servidor
# BACKUP_KEEP_DAYS=14

# --- Cofre de certificados digitais A1 (motor de tribunais, etapa 0) ---
# Chave de 32 bytes em base64, DIFERENTE da do MFA. Gere com:  openssl rand -base64 32
# Sem ela o cofre fica indisponível. Se for perdida, os certificados guardados precisam ser enviados de novo.
# CERT_ENCRYPTION_KEY=

# --- Conector PJe/MNI (etapa 1 do motor de tribunais) ---
# Arquivo PEM com a cadeia ICP-Brasil, caso o Node não confie no certificado do tribunal.
# MNI_EXTRA_CA_FILE=
# SOMENTE para testes locais: permite endpoint http/localhost. Nunca em produção.
# MNI_ALLOW_LOCAL_ENDPOINTS=1

# --- Captura de publicações do DJEN (etapa 2a) ---
# Segredo (mín. 24 caracteres) do agendador. Sem ele as rotas /api/cron/djen e /api/cron/mni ficam desligadas. Gere:  openssl rand -base64 32
# Agende, por exemplo a cada 30 min:  curl -fsS -X POST -H "Authorization: Bearer $CRON_SECRET" https://SEU-DOMINIO/api/cron/djen
#   e o mesmo para o PJe/MNI:  .../api/cron/mni
# CRON_SECRET=
# Endereço da API pública do DJEN (padrão abaixo). DJEN_ALLOW_LOCAL=1 só para testes.
# DJEN_API_BASE=https://comunicaapi.pje.jus.br/api/v1

# --- Avisos no celular (push, 2.0-F14). Veja docs/push.md. Sem estas chaves o recurso fica desligado. ---
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:contato@seu-dominio

# Quem pode criar conta/escritório: open (padrão, só desenvolvimento) | code (exige REGISTRATION_CODE) | closed (só por convite).
# Em produção use code (para criar a primeira conta) e depois closed. Convite válido sempre funciona.
# REGISTRATION_MODE=closed
# REGISTRATION_CODE=(mínimo 12 caracteres; gere com: openssl rand -hex 12)

# --- Cobrança automática (Asaas). Só funciona com conta no Asaas; sem estas variáveis fica DESLIGADA (sem simular) ---
# ASAAS_API_KEY=            # chave de API (Asaas → Integrações). Comece pela SANDBOX.
# ASAAS_WEBHOOK_TOKEN=      # invente um segredo de 24+ caracteres (openssl rand -hex 24) e cadastre o MESMO no webhook do Asaas
# ASAAS_ENV=sandbox         # sandbox (padrão) | production
# Webhook no Asaas: URL https://SEU-DOMINIO/api/billing/asaas/webhook, eventos de cobrança (PAYMENT_*) e de assinatura
# (SUBSCRIPTION_DELETED, SUBSCRIPTION_INACTIVATED), token de autenticação = ASAAS_WEBHOOK_TOKEN.

# --- Atendimento por WhatsApp (API oficial da Meta). Sem estas variáveis fica DESLIGADO (nada é simulado) ---
# WHATSAPP_APP_SECRET=      # "Chave secreta do app" (Meta for Developers → seu app → Configurações → Básico). Assina os webhooks.
# WHATSAPP_VERIFY_TOKEN=    # invente um segredo de 16+ caracteres (openssl rand -hex 16) e cadastre o MESMO no webhook da Meta
# WHATSAPP_API_VERSION=v21.0   # confira a versão vigente da Graph API no painel da Meta
# Webhook na Meta: URL https://SEU-DOMINIO/api/whatsapp/webhook, campo "messages". O token de acesso do número é colado em Atendimento → Configurações (cifrado).

# WhatsApp por QR-Code (opção avançada, não oficial)
# WHATSAPP_QR_MIN_GAP_MS=1500          # intervalo mínimo entre envios de um número
# WHATSAPP_QR_DISABLE_RESUME=1         # não religar as sessões ao subir o servidor
# WHATSAPP_QR_FAKE=1                   # SÓ TESTES: simula o QR-Code; check:prod recusa em produção
