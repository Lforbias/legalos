{
  "manifest_version": 3,
  "minimum_chrome_version": "120",
  "name": "LegalOS — PJe assistido",
  "version": "0.2.0",
  "description": "Auxilia o segundo fator no login oficial PJe/Jus.br e detecta números CNJ nas páginas autorizadas para conferência no LegalOS.",
  "permissions": ["activeTab", "scripting", "storage", "alarms"],
  "host_permissions": ["https://www.legalossync.tech/*"],
  "optional_host_permissions": ["https://*.jus.br/*"],
  "background": { "service_worker": "background.mjs", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "LegalOS PJe" }
}
